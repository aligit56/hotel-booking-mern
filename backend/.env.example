PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking_db
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Optional values used by `npm run create-admin`:
# ADMIN_NAME=Hotel Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# Optional if multiple administrator accounts exist; used by `npm run seed:demo`:
# DEMO_DATA_OWNER_EMAIL=admin@example.com
# Alternatively provision a dedicated sample host (no default credentials):
# DEMO_OWNER_NAME=Staywell Demo Host
# DEMO_OWNER_EMAIL=demo-host@example.com
# DEMO_OWNER_PASSWORD=choose-a-private-password
